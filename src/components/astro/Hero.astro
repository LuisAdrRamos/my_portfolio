---
import { Download, MapPin, Building2, Terminal } from '@lucide/astro';
import Github from '../icons/Github.astro';
import Linkedin from '../icons/Linkedin.astro';
---

<section id="about" class="relative min-h-[90vh] flex items-center justify-center pt-20 overflow-hidden">
  
  <!-- Background Elements -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-accent-cyan/10 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[30rem] h-[30rem] bg-accent-purple/10 rounded-full blur-[120px]"></div>
    <div class="absolute inset-0 bg-[url('/noise.png')] opacity-[0.03] mix-blend-overlay"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
    <div class="flex flex-col md:flex-row items-center gap-12 md:gap-20">
      
      <!-- Text Content -->
      <div class="flex-1 space-y-8 text-center md:text-left">
        
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-cyan/10 border border-accent-cyan/20 text-accent-cyan text-sm font-code mb-4">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-cyan opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-accent-cyan"></span>
            </span>
            Open to new opportunities
          </div>
          
          <h1 class="text-5xl md:text-7xl font-heading font-bold tracking-tight text-text-primary">
            Luis Adrián <br class="hidden md:block"/> Ramos
          </h1>
          
          <div class="h-12 flex items-center justify-center md:justify-start">
            <h2 class="text-xl md:text-3xl font-body text-text-secondary">
              <span class="text-accent-cyan mr-2">&gt;</span>
              <span id="typewriter" class="border-r-2 border-accent-cyan pr-1"></span>
            </h2>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center md:justify-start gap-6 text-text-muted font-body">
          <div class="flex items-center gap-2">
            <Building2 class="w-5 h-5 text-accent-purple" />
            <span>EPN — ESFOT</span>
          </div>
          <div class="hidden sm:block text-border-subtle">•</div>
          <div class="flex items-center gap-2">
            <MapPin class="w-5 h-5 text-accent-mint" />
            <span>Ecuador</span>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 pt-4">
          <a href="#projects" class="magnetic-btn glow-hover flex items-center gap-2 bg-text-primary text-bg-primary px-6 py-3 rounded-lg font-medium transition-all">
            <Terminal class="w-5 h-5" />
            View Projects
          </a>
          
          <a href="/cv-luis-adrian-ramos.pdf" target="_blank" class="magnetic-btn flex items-center gap-2 glass-panel hover:bg-white/10 px-6 py-3 rounded-lg font-medium text-text-primary transition-all">
            <Download class="w-5 h-5" />
            Download CV
          </a>
          
          <div class="flex items-center gap-2 ml-2">
            <a href="https://github.com/LuisAdrRamos" target="_blank" rel="noopener noreferrer" class="p-3 rounded-lg glass-panel hover:bg-white/10 text-text-secondary hover:text-accent-cyan transition-all magnetic-btn" aria-label="GitHub">
              <Github class="w-5 h-5" />
            </a>
            <a href="https://www.linkedin.com/in/luisadrianramos" target="_blank" rel="noopener noreferrer" class="p-3 rounded-lg glass-panel hover:bg-white/10 text-text-secondary hover:text-accent-cyan transition-all magnetic-btn" aria-label="LinkedIn">
              <Linkedin class="w-5 h-5" />
            </a>
          </div>
        </div>
      </div>

      <!-- Profile Image / Graphic -->
      <div class="flex-1 w-full max-w-md mx-auto md:max-w-none relative perspective-1000">
        <div class="relative w-72 h-72 md:w-96 md:h-96 mx-auto rounded-3xl overflow-hidden glass-panel border border-border-default/50 p-2 shadow-2xl shadow-accent-cyan/5">
          <!-- Placeholder until real image is provided -->
          <div class="absolute inset-2 rounded-2xl bg-gradient-to-br from-bg-elevated to-bg-secondary flex flex-col items-center justify-center border border-border-subtle overflow-hidden group">
            
            <!-- Imagen de perfil -->
            <img src="/assets/profile-photo.jpg" alt="Luis Adrián Ramos" class="w-full h-full object-cover rounded-2xl" />
            
            <Terminal class="w-16 h-16 text-border-subtle group-hover:text-accent-cyan/50 transition-colors duration-500 mb-4" />
            <div class="font-code text-text-muted text-sm group-hover:text-accent-cyan/70 transition-colors duration-500">
              await fetchProfileImage()
            </div>
            
            <!-- Decorative code lines -->
            <div class="absolute bottom-6 left-6 space-y-2 opacity-30 w-3/4">
              <div class="h-2 bg-accent-cyan rounded w-1/2"></div>
              <div class="h-2 bg-accent-purple rounded w-3/4"></div>
              <div class="h-2 bg-accent-mint rounded w-1/3"></div>
            </div>
          </div>
        </div>
        
        <!-- Floating Elements -->
        <div class="absolute -top-6 -right-6 glass-panel px-4 py-3 rounded-xl animate-float-slow">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-accent-cyan/20 flex items-center justify-center">
              <span class="text-accent-cyan font-bold font-code text-xs">AI</span>
            </div>
            <div class="text-sm font-medium text-text-primary">Local LLMs</div>
          </div>
        </div>
        
        <div class="absolute -bottom-6 -left-6 glass-panel px-4 py-3 rounded-xl animate-float-fast">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-accent-purple/20 flex items-center justify-center">
              <span class="text-accent-purple font-bold font-code text-xs">BE</span>
            </div>
            <div class="text-sm font-medium text-text-primary">Backend Dev</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Custom animations for the hero section */
  .animate-float-slow {
    animation: float 6s ease-in-out infinite;
  }
  
  .animate-float-fast {
    animation: float 4s ease-in-out infinite;
    animation-delay: 1s;
  }
  
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
    100% { transform: translateY(0px); }
  }
  
  .perspective-1000 {
    perspective: 1000px;
  }
</style>

<script>
  // Typewriter Effect
  const texts = [
    "Backend Developer",
    "Local AI Engineer",
    "Systems Architect",
    "Full-Stack Dev"
  ];
  
  let textIndex = 0;
  let charIndex = 0;
  let isDeleting = false;
  let isPaused = false;
  const typeElement = document.getElementById('typewriter');
  
  function typeWriter() {
    if (!typeElement) return;
    
    const currentText = texts[textIndex];
    
    if (isPaused) {
      setTimeout(typeWriter, 2000); // Pause at the end of the word
      isPaused = false;
      isDeleting = true;
      return;
    }
    
    if (isDeleting) {
      typeElement.textContent = currentText.substring(0, charIndex - 1);
      charIndex--;
    } else {
      typeElement.textContent = currentText.substring(0, charIndex + 1);
      charIndex++;
    }
    
    let typingSpeed = isDeleting ? 50 : 100;
    
    if (!isDeleting && charIndex === currentText.length) {
      isPaused = true;
    } else if (isDeleting && charIndex === 0) {
      isDeleting = false;
      textIndex = (textIndex + 1) % texts.length;
      typingSpeed = 500; // Pause before typing next word
    }
    
    setTimeout(typeWriter, typingSpeed);
  }
  
  // Start the typing effect when the DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(typeWriter, 500);
  });
</script>



